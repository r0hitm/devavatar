---
import { LOCALE, SITE } from "@/consts";
import Socials from "./Socials.astro";
import { CircleOff } from "@lucide/astro";
import { useTranslations } from "@/i18n/utils";
import Link from "./Link.astro";

const Lang = (Astro.currentLocale as "ja" | "en") || LOCALE.lang;
const t = useTranslations(Lang);

const currentYear = new Date().getFullYear();
const author = SITE.author;
---

<footer
    class="border-d-border mx-auto mt-6 w-full max-w-4xl border-t px-4 pt-8 pb-4 opacity-90">
    <Socials centered showRss />

    <div
        class="mt-2 flex flex-col items-center justify-center gap-y-2 text-sm sm:flex-row sm:gap-x-4">
        <Link
            href="/support"
            class="block underline decoration-dashed underline-offset-4 hover:decoration-wavy">
            {t("footer.support")}
        </Link>
        <span class="hidden sm:block">・</span>
        <Link
            href="https://github.com/r0hitm/devavatar-kaisei/issues"
            class="block underline decoration-dashed underline-offset-4 hover:decoration-wavy"
            rel="noopener noreferrer">
            {t("footer.issue")}
        </Link>
    </div>

    <p class="mt-4 text-center text-sm">
        <!-- No cookies, no ads, no tracking ― just blog. -->
        <CircleOff class="mr-1 inline-block size-3 fill-inherit align-middle" />
        {t("footer.ai")}
        <CircleOff class="ml-1 inline-block size-3 fill-inherit align-middle" />
    </p>

    <div
        class="mt-2 flex flex-col items-center justify-center gap-y-2 text-sm sm:flex-row sm:gap-x-4">
        <span>
            &copy; {currentYear}
            {author}
        </span>
        <span class="hidden sm:block">・</span>
        <span>
            <Link
                href="http://creativecommons.org/licenses/by-nc-sa/4.0/"
                class="hover:underline hover:decoration-wavy hover:underline-offset-4"
                target="_blank">
                CC BY-NC-SA 4.0
            </Link>
        </span>
    </div>
</footer>
