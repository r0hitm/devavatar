---
import { Hash } from "@lucide/astro";

export interface Props {
    tag: string;
    tagName: string;
    size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li
    class:list={[
        `inline-block ${
            size === "sm"
                ? "my-1 underline-offset-4"
                : "mx-1 my-3 underline-offset-8"
        }`
    ]}
>
    <a
        href={`/tags/${tag}`}
        transition:name={tag}
        class:list={[
            "group hover:text-d-accent focus-visible:bg-d-accent focus-visible:text-apricot-50 relative inline-block rounded border border-dashed px-2 hover:rotate-2",
            size === "sm" ? "text-sm" : "text-lg"
        ]}
    >
        <Hash class="inline-block size-4 align-middle" />
        <span>{tagName}</span>
    </a>
</li>
