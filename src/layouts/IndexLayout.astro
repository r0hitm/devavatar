---
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Prose from "@/components/Prose.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import getPosts from "@/utils/getPosts";
import { ArrowRight, Rss } from "@lucide/astro";
import { getCollection } from "astro:content";
import getUniqueTags from "@/utils/getUniqueTags";
import Tag from "@/components/Tag.astro";
import Link from "@/components/Link.astro";
import { LOCALE } from "@/consts";
import { useTranslations } from "@/i18n/utils";

const Lang = (Astro.currentLocale as "ja" | "en") || LOCALE.lang;
const t = useTranslations(Lang);

// BUG: 最適化バグだ。以下のせいでdevサーバーが遅すぎるかもね
const posts = await getPosts();
const projects = (await getCollection("project")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const tags = getUniqueTags(posts);
---

<RootLayout>
    <section>
        <h1 class="my-4 text-3xl font-bold">
            {t("page.home.welcome")}
            <Link
                target="_blank"
                href="/rss.xml"
                rel="noopener noreferrer"
                aria-label="rss-link"
                title="RSS Feed">
                <Rss
                    class="stroke-d-accent m-auto inline-block size-5 align-middle"
                />
            </Link>
        </h1>

        <Prose>
            <article>
                <slot />
            </article>
        </Prose>
    </section>

    <Hr />

    <section>
        <h2 class="text-2xl font-semibold tracking-wide">
            {t("page.home.posts.heading")}
        </h2>
        <ul>
            {
                posts.map(
                    ({ data, id }, index) =>
                        index < 4 && (
                            <Card
                                href={`/posts/${id}`}
                                postId={id}
                                frontmatter={data}
                            />
                        )
                )
            }
        </ul>
        <div class="my-4 text-center">
            <Link
                href="/posts"
                class="group hover:text-d-accent inline-flex items-center justify-center gap-2">
                {t("page.home.posts.all")}
                <ArrowRight
                    class="group-hover:text-d-accent text-d-txt-base size-4"
                />
            </Link>
        </div>
    </section>

    <Hr />

    <section>
        <h2 class="text-2xl font-semibold tracking-wide">
            {t("page.home.projects.heading")}
        </h2>
        <ul>
            {
                projects.map(
                    (project, index) =>
                        index < 1 && <ProjectCard {...project.data} />
                )
            }
        </ul>
        <div class="my-4 text-center">
            <Link
                href="/projects"
                class="group hover:text-d-accent inline-flex items-center justify-center gap-2">
                {t("page.home.projects.all")}
                <ArrowRight
                    class="group-hover:text-d-accent text-d-txt-base size-4"
                />
            </Link>
        </div>
    </section>

    <Hr />

    <section>
        <h2 class="text-2xl font-semibold tracking-wide">
            {t("page.tags.heading")}
        </h2>

        <ul>
            {
                // TODO: タグを記事数に従って、ソート化
                tags.map(
                    ({ tag, tagName }, index) =>
                        index < 5 && (
                            <Tag tag={tag} tagName={tagName} size="lg" />
                        )
                )
            }
        </ul>
        <div class="my-4 text-center">
            <Link
                href="/tags"
                class="group hover:text-d-accent inline-flex items-center justify-center gap-2">
                {t("page.tag.gotoall")}
                <ArrowRight
                    class="group-hover:text-d-accent text-d-txt-base size-4"
                />
            </Link>
        </div>
    </section>
</RootLayout>
