---
import type { GetStaticPaths } from "astro";
import RootLayout from "@/layouts/RootLayout.astro";
import getPosts from "@/utils/getPosts";
import getUniqueTags from "@/utils/getUniqueTags";
import Card from "@/components/Card.astro";
import { slugifyAll } from "@/utils/slugify";
import { LOCALE, SITE } from "@/consts";
import { Tags } from "@lucide/astro";
import { useTranslations } from "@/i18n/utils";

const Lang = (Astro.currentLocale as "ja" | "en") || LOCALE.lang;
const t = useTranslations(Lang);

export const getStaticPaths = (async () => {
    const posts = await getPosts();

    const tags = getUniqueTags(posts);
    return tags.map(({ tag, tagName }) => {
        return {
            params: { tag },
            props: { tag, tagName, posts }
        };
    });
}) satisfies GetStaticPaths;

const { tag, tagName, posts } = Astro.props;

const postsByTag = posts.filter(post =>
    slugifyAll(post.data.tags).includes(tag)
);
---

<RootLayout
    title={`${tagName} | ${SITE.title}`}
    description={`${t("page.tag.active")}: ${tagName}`}>
    <!-- TODO: breadcrumbs -->

    <h1 class="mb-2 text-3xl font-bold">
        {t("page.tag.active")}: <span transition:name={tag}>{tagName}</span>
    </h1>

    <div
        class="mb-4 flex flex-col items-start justify-between sm:flex-row sm:items-center">
        <p class="italic">
            {postsByTag.length}
            {t("page.tag.posts")}
        </p>
        <a class="inline-flex items-center gap-2" href="/tags">
            <Tags class="text-d-accent size-4" />
            <span
                class="decoration-d-accent underline decoration-dashed underline-offset-4 hover:no-underline"
                >{t("page.tag.gotoall")}</span
            >
        </a>
    </div>

    <ul>
        {
            postsByTag.map(({ data, id }) => (
                <Card href={`/posts/${id}`} postId={id} frontmatter={data} />
            ))
        }
    </ul>
</RootLayout>
